APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
DATABASE_URL=
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
STORAGE_DRIVER=supabase
# Isi hanya untuk project Supabase development khusus Princes pada fase database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attendance-photos
# Bootstrap CLI satu kali; hapus variabel BOOTSTRAP_OWNER_* setelah berhasil.
BOOTSTRAP_OWNER_ID=
BOOTSTRAP_OWNER_PASSWORD=
# Seed hanya pada database development terpisah, tidak pernah di production:
APP_ENV=development
ALLOW_DEMO_SEED=false
# UUID bisnis yang sama untuk runtime dan bootstrap CLI; buat UUID baru untuk instalasi nyata:
APP_BUSINESS_ID=
BOOTSTRAP_OWNER_NAME=Owner Reza
BOOTSTRAP_BUSINESS_NAME=Absensi Kita

# Batas pool koneksi server (opsional, 1–10):
DATABASE_POOL_MAX=3

# TLS remote selalu diverifikasi. Isi PEM root CA bila diperlukan provider.
DATABASE_SSL_CA=
# Key backup terpisah dari SESSION_SECRET: 32 byte acak, format 64 digit hex.
# Simpan di password manager; kehilangan key membuat backup tidak dapat dipulihkan.
BACKUP_ENCRYPTION_KEY=
