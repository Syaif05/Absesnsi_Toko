# Salin ke .env.production.local (gitignored), chmod 600, isi pada server pemilik.
# Nilai di sini contoh kosong, tidak dapat dipakai untuk deployment.
NODE_ENV=production
APP_ENV=production
ALLOW_DEMO_SEED=false
APP_BASE_URL=https://attendance.example.com
APP_TIMEZONE=Asia/Jakarta
# UUID baru yang tetap sama untuk bootstrap dan runtime instalasi pemilik.
APP_BUSINESS_ID=
DATABASE_URL=
DATABASE_POOL_MAX=3
DATABASE_SSL_CA=
SESSION_SECRET=
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attendance-photos
# BACKUP_ENCRYPTION_KEY hanya untuk proses admin/backup, jangan inject ke web.
# BOOTSTRAP_OWNER_* hanya untuk proses CLI awal, jangan simpan di runtime web.
